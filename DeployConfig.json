        "type": "CONFIG",
        "essential": true
      },
      {
        "name": "MODULE_URL",
        "value": null,
        "description": "Internal URL (host:port) at which the mod-oai-pmh backend container is reachable from its sidecar",
        "type": "CONFIG",
        "essential": true
      },
      {
        "name": "MODULE_VERSION",
        "value": null,
        "description": "Version of the mod-oai-pmh module deployed alongside this sidecar",
        "type": "CONFIG",
        "essential": true
      }
